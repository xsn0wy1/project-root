# Include from XAMPP's httpd.conf after replacing /ABSOLUTE/PATH/project-root.
# No application PHP, configuration, SQL or uploads are under DocumentRoot.
<VirtualHost *:80>
    ServerName hospital.localhost
    DocumentRoot "/ABSOLUTE/PATH/project-root/public"
    Alias "/api/v1/" "/ABSOLUTE/PATH/project-root/backend/api/v1/"
    # Patient file URLs contain bearer tokens. Log the path, never query strings.
    LogFormat "%h %l %u %t \"%m %U %H\" %>s %b" hospital_no_query
    CustomLog "logs/hospital-access.log" hospital_no_query
    <Directory "/ABSOLUTE/PATH/project-root/public">
        DirectoryIndex index.php
        Options -Indexes +FollowSymLinks
        AllowOverride FileInfo Options
        Require all granted
        <IfModule headers_module>
            <FilesMatch "\.(css|js)$">
                Header set Cache-Control "no-cache"
            </FilesMatch>
        </IfModule>
    </Directory>
    <Directory "/ABSOLUTE/PATH/project-root/backend/api/v1">
        Options -Indexes
        AllowOverride None
        Require all granted
        <IfModule php_module>
            php_value upload_max_filesize 10M
            php_value post_max_size 11M
        </IfModule>
    </Directory>
    <Location "/api/v1/">
        ErrorDocument 404 /api/v1/errors/not-found.php
    </Location>
</VirtualHost>
