Options -Indexes
AddType application/javascript .mjs
AddType application/wasm .wasm

# Preserve Alias mounts; Apache normalizes the extra leading slash.
ErrorDocument 403 /%{CONTEXT_PREFIX}/src/views/error.php?status=403
ErrorDocument 404 /%{CONTEXT_PREFIX}/src/views/error.php?status=404
ErrorDocument 500 /%{CONTEXT_PREFIX}/src/views/error.php?status=500
